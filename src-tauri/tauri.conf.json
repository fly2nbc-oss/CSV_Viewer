{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSV Viewer",
  "version": "1.0.0",
  "identifier": "com.fly2nbc.csv-viewer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSV Viewer",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
